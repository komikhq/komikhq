{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "./worker-configuration.d.ts"],
  "exclude": ["dist", "node_modules", "api"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["./worker-configuration.d.ts", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
