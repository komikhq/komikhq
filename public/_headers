# Favicons & App Icons (7 days fresh, 1 day stale revalidation)
/favicon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icon-*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Brand Logos & Vector Assets (30 days fresh, 1 day stale revalidation)
/logo*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Public Images & OpenGraph Assets (30 days fresh, 1 day stale revalidation)
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# SEO & Crawlers (1 day fresh, 1 hour stale revalidation)
/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/sitemap*.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
