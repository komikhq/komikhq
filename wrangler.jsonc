{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "name": "komikhq",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,

  "routes": [
    {
      "pattern": "web.komikhq.dpdns.org",
      "custom_domain": true
    }
  ],

  "main": "@astrojs/cloudflare/entrypoints/server",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }

  // "services": [
  //   {
  //     "binding": "BACKEND",
  //     "service": "komikhq-api"
  //   }
  // ]
}
