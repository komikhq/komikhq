{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "komikhq-astro",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "HONO_API",
      "service": "komikhq-api"
    }
  ]
}