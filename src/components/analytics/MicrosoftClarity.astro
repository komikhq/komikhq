---
interface Props {
  projectId?: string
}

const { projectId = import.meta.env.PUBLIC_CLARITY_ID } = Astro.props
---

<script is:inline define:vars={{ projectId }}>
  if (projectId) {
    ;(function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          ;(c[a].q = c[a].q || []).push(arguments)
        }
      t = l.createElement(r)
      t.async = 1
      t.src = "https://www.clarity.ms/tag/" + projectId
      y = l.getElementsByTagName(r)[0]
      y.parentNode.insertBefore(t, y)

      let isExperienceGranted = false
      try {
        const raw = localStorage.getItem("komikhq_cookie_consent_v1")
        if (raw) {
          const parsed = JSON.parse(raw)
          if (parsed && parsed.experience === true) {
            isExperienceGranted = true
          }
        }
      } catch (_) {}

      c[a]("consent", isExperienceGranted)
    })(window, document, "clarity", "script")
  }
</script>
