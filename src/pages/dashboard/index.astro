---
import RootLayout from "@/layouts/RootLayout.astro";
import { AdminGuard } from "@/components/admin/AdminGuard";
import { AdminHeader } from "@/components/admin/AdminHeader";
import { AdminTabNav } from "@/components/admin/AdminTabNav";
import { AdminStatsOverviewCard } from "@/components/admin/AdminStatsOverviewCard";
import { AdminUserManagementCard } from "@/components/admin/AdminUserManagementCard";
---

<RootLayout title="Control Panel & Dashboard Admin - KomikHQ">
  <div class="max-w-6xl mx-auto flex flex-col gap-6 pb-20 pt-4 px-4">
    <AdminHeader client:load />
    <AdminTabNav currentTab="overview" client:load />

    <AdminGuard client:only="react">
      <AdminStatsOverviewCard client:load />
      <AdminUserManagementCard client:load />
    </AdminGuard>
  </div>
</RootLayout>
