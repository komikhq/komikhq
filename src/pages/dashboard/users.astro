---
import RootLayout from "@/layouts/RootLayout.astro"
import { AdminTabNav } from "@/components/admin/AdminTabNav"
import { AdminUsersView } from "@/components/admin/AdminUsersView"
import { AdminFooter } from "@/components/admin/AdminFooter"
---

<RootLayout title="User Management - Admin Dashboard | KomikHQ">
  <div class="flex w-full flex-col gap-6 px-4 pt-4 pb-20 sm:px-6 lg:px-8">
    <AdminTabNav currentTab="users" client:load />

    <AdminUsersView client:only="react" />

    <AdminFooter client:load />
  </div>
</RootLayout>
