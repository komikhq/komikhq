---
import RootLayout from "@/layouts/root-layout.astro"
import { AdminGuard } from "@/components/admin/common/admin-guard"
import { AdminTabNav } from "@/components/admin/common/admin-tab-nav"
import { AdminFooter } from "@/components/admin/common/admin-footer"
import { SettingsDiagnosticsCard } from "@/components/admin/settings/settings-diagnostics-card"
import { SettingsSyncViewsCard } from "@/components/admin/settings/settings-sync-views-card"
import { SettingsSearchCacheCard } from "@/components/admin/settings/settings-search-cache-card"
import { SettingsR2PurgeCard } from "@/components/admin/settings/settings-r2-purge-card"
---

<RootLayout
  title="Platform Settings - Admin Dashboard | KomikHQ"
  noIndex={true}
>
  <div class="flex w-full flex-col gap-6 px-4 pt-4 pb-20 sm:px-6 lg:px-8">
    <AdminTabNav currentTab="settings" client:load />

    <AdminGuard client:only="react">
      <SettingsDiagnosticsCard client:only="react" />
      <SettingsSyncViewsCard client:only="react" />
      <SettingsSearchCacheCard client:only="react" />
      <SettingsR2PurgeCard client:only="react" />
    </AdminGuard>

    <AdminFooter client:load />
  </div>
</RootLayout>
