---
import RootLayout from "@/layouts/RootLayout.astro"
import { AdminGuard } from "@/components/admin/common/AdminGuard"
import { AdminTabNav } from "@/components/admin/common/AdminTabNav"
import { AdminFooter } from "@/components/admin/common/AdminFooter"
import { SettingsDiagnosticsCard } from "@/components/admin/settings/SettingsDiagnosticsCard"
import { SettingsSyncViewsCard } from "@/components/admin/settings/SettingsSyncViewsCard"
import { SettingsSearchCacheCard } from "@/components/admin/settings/SettingsSearchCacheCard"
import { SettingsR2PurgeCard } from "@/components/admin/settings/SettingsR2PurgeCard"
---

<RootLayout title="Platform Settings - Admin Dashboard | KomikHQ" noIndex={true}>
  <div class="flex w-full flex-col gap-6 px-4 pt-4 pb-20 sm:px-6 lg:px-8">
    <AdminTabNav currentTab="settings" client:load />

    <AdminGuard client:only="react">
      <SettingsDiagnosticsCard client:only="react" />
      <SettingsSyncViewsCard client:only="react" />
      <SettingsSearchCacheCard client:only="react" />
      <SettingsR2PurgeCard client:only="react" />
    </AdminGuard>

    <AdminFooter client:load />
  </div>
</RootLayout>
