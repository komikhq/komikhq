---
import RootLayout from "@/layouts/RootLayout.astro"
import { AdminTabNav } from "@/components/admin/AdminTabNav"
import { AdminComicDetailView } from "@/components/admin/chapters/AdminComicDetailView"
import { AdminFooter } from "@/components/admin/AdminFooter"

const { id } = Astro.params
---

<RootLayout title="Comic Chapter Management - Admin Dashboard | KomikHQ">
  <div class="flex w-full flex-col gap-6 px-4 pt-4 pb-20 sm:px-6 lg:px-8">
    <AdminTabNav currentTab="comics" client:load />

    <AdminComicDetailView comicId={id || ""} client:only="react" />

    <AdminFooter client:load />
  </div>
</RootLayout>
