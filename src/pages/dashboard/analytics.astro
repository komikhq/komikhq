---
import RootLayout from "@/layouts/root-layout.astro"
import { AdminGuard } from "@/components/admin/common/admin-guard"
import { AdminTabNav } from "@/components/admin/common/admin-tab-nav"
import { AdminAnalyticsCard } from "@/components/admin/analytics/admin-analytics-card"
import { AdminFooter } from "@/components/admin/common/admin-footer"
---

<RootLayout
  title="Platform Analytics - Admin Dashboard | KomikHQ"
  noIndex={true}
>
  <div class="flex w-full flex-col gap-6 px-4 pt-4 pb-20 sm:px-6 lg:px-8">
    <AdminTabNav currentTab="analytics" client:load />

    <AdminGuard client:only="react">
      <AdminAnalyticsCard />
    </AdminGuard>

    <AdminFooter client:load />
  </div>
</RootLayout>
