import { AdminHeader } from "@/components/admin/AdminHeader";
import { AdminTabNav } from "@/components/admin/AdminTabNav";
import { AdminModerationCard } from "@/components/admin/AdminModerationCard";
---

<RootLayout title="Moderasi Komentar - Dashboard Admin | KomikHQ">
  <AdminGuard client:only="react">
    <div class="container mx-auto px-4 py-6 space-y-6 max-w-7xl">
      <AdminHeader />
      <AdminTabNav currentTab="moderation" client:only="react" />
      <AdminModerationCard client:only="react" />
    </div>
