---
import RootLayout from "@/layouts/RootLayout.astro"
import { AdminGuard } from "@/components/admin/common/AdminGuard"
import { AdminTabNav } from "@/components/admin/common/AdminTabNav"
import { AdminModerationCard } from "@/components/admin/moderation/AdminModerationCard"
import { AdminFooter } from "@/components/admin/common/AdminFooter"
---

<RootLayout title="Comment Moderation - Admin Dashboard | KomikHQ" noIndex={true}>
  <div class="flex w-full flex-col gap-6 px-4 pt-4 pb-20 sm:px-6 lg:px-8">
    <AdminTabNav currentTab="moderation" client:only="react" />

    <AdminGuard client:only="react">
      <AdminModerationCard client:only="react" />
    </AdminGuard>

    <AdminFooter client:load />
  </div>
</RootLayout>
