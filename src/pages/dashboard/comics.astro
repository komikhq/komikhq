---
import RootLayout from "@/layouts/RootLayout.astro";
import { AdminGuard } from "@/components/admin/AdminGuard";
import { AdminHeader } from "@/components/admin/AdminHeader";
import { AdminTabNav } from "@/components/admin/AdminTabNav";
import { AdminComicManagementCard } from "@/components/admin/AdminComicManagementCard";
---

<RootLayout title="Manajemen Katalog Komik - KomikHQ">
  <div class="max-w-6xl mx-auto flex flex-col gap-6 pb-20 pt-4 px-4">
    <AdminHeader client:load />
    <AdminTabNav currentTab="comics" client:load />

    <AdminGuard client:only="react">
      <AdminComicManagementCard client:load />
    </AdminGuard>
  </div>
</RootLayout>
