---
import RootLayout from "@/layouts/RootLayout.astro";
import { AdminTabNav } from "@/components/admin/AdminTabNav";
import { AdminGenresView } from "@/components/admin/genres/AdminGenresView";
import { AdminFooter } from "@/components/admin/AdminFooter";
---

<RootLayout title="Genre Management - Admin Dashboard | KomikHQ">
  <div class="w-full flex flex-col gap-6 pb-20 pt-4 px-4 sm:px-6 lg:px-8">
    <AdminTabNav currentTab="genres" client:load />

    <AdminGenresView client:only="react" />

    <AdminFooter client:load />
  </div>
</RootLayout>

