---
import RootLayout from "@/layouts/RootLayout.astro"
import { BrowseFilterBar } from "@/components/browse/BrowseFilterBar"
import { BrowseComicGrid } from "@/components/browse/BrowseComicGrid"
---

<RootLayout
  title="Browse Latest Manga & Manhwa in Bahasa Indonesia | KomikHQ"
  description="Explore thousands of popular manga, manhwa, and manhua translated into Bahasa Indonesia with complete genre and status filters on KomikHQ."
>
  <div class="mx-auto flex max-w-screen-2xl flex-col gap-6 px-4 pt-4 pb-20">
    <BrowseFilterBar client:load />
    <BrowseComicGrid client:load />
  </div>
</RootLayout>
