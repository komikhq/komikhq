---
import RootLayout from "@/layouts/RootLayout.astro";
import { AuthGuard } from "@/components/auth/AuthGuard";
import { AccountTabNav } from "@/components/account/AccountTabNav";
import { AccountThemeCard } from "@/components/account/AccountThemeCard";
import { AccountPreferencesCard } from "@/components/account/AccountPreferencesCard";
import { AccountDangerZoneCard } from "@/components/account/AccountDangerZoneCard";
import { UserCircle } from "@phosphor-icons/react";
---

<RootLayout title="Pengaturan Akun - KomikHQ">
  <div class="max-w-4xl mx-auto space-y-6 pb-20 pt-4 px-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight flex items-center gap-2">
          <UserCircle className="h-6 w-6 text-primary" />
          <span>Account Center</span>
        </h1>
        <p class="text-sm text-muted-foreground">
          Kelola profil pribadi, kredensial, dan preferensi aplikasi Anda.
        </p>
      </div>

      <AccountTabNav currentTab="settings" client:load />
    </div>

    <AuthGuard client:only="react">
      <div class="space-y-6">
        <AccountThemeCard client:load />
        <AccountPreferencesCard client:load />
        <AccountDangerZoneCard client:load />
      </div>
    </AuthGuard>
  </div>
</RootLayout>
