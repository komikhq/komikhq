---
import RootLayout from "@/layouts/RootLayout.astro"
import { ErrorViewCard } from "@/components/error/ErrorViewCard"

interface Props {
  error?: unknown
}

const { error } = Astro.props
---

<RootLayout title="500 - Kesalahan Internal Server | KomikHQ">
  <div
    class="mx-auto flex min-h-[75vh] max-w-screen-xl flex-col justify-center px-4 py-8"
  >
    <ErrorViewCard code={500} error={error} client:load />
  </div>
</RootLayout>
