---
import RootLayout from "@/layouts/root-layout.astro"
import { ReaderHeaderBar } from "@/components/reader/reader-header-bar"
import { ReaderImageStack } from "@/components/reader/reader-image-stack"
import { ReaderFooterNav } from "@/components/reader/reader-footer-nav"
import { chaptersApi } from "@/lib/sdk-client"

const { slug, chapterSlug } = Astro.params

interface ChapterData {
  comic?: { title?: string; id?: string }
  chapter?: { title?: string; chapterNumber?: string; id?: string }
  pages?: any[]
  allChapters?: any[]
}

const formatSlug = (value: string | undefined, fallback: string) =>
  value
    ? value
        .replace(/-/g, " ")
        .replace(/\b\w/g, (letter) => letter.toUpperCase())
    : fallback

const formattedSlug = formatSlug(slug?.replace(/-\d{4}$/, ""), "Comic")
const fallbackChapter = chapterSlug
  ? `Chapter ${chapterSlug.replace(/^(chapter-|ch-)/i, "")}`
  : "Chapter"
let comicTitle = formattedSlug
let chapterTitle = fallbackChapter
let chapterData: ChapterData | null = null

if (slug && chapterSlug) {
  try {
    chapterData = (await chaptersApi.getPublicChapter({
      slug,
      chapterSlug,
    })) as unknown as ChapterData
    comicTitle = chapterData?.comic?.title || comicTitle
    chapterTitle = chapterData?.chapter?.title || chapterTitle
  } catch (error) {
    console.warn(
      `[ReaderPage] Failed to load chapter metadata for ${slug}/${chapterSlug}:`,
      error
    )
  }
}

const title = `Read ${comicTitle} ${chapterTitle} Online | KomikHQ`
const description = `Read ${comicTitle} ${chapterTitle} online in high quality with distraction-free scrolling on KomikHQ.`
---

<RootLayout title={title} description={description} isReaderMode={true}>
  <div class="min-h-screen bg-neutral-950 pb-20 text-neutral-100">
    <ReaderHeaderBar comicSlug={slug} chapterSlug={chapterSlug} initialData={chapterData} client:load />
    <ReaderImageStack comicSlug={slug} chapterSlug={chapterSlug} initialData={chapterData} client:load />
    <ReaderFooterNav comicSlug={slug} chapterSlug={chapterSlug} initialData={chapterData} client:load />
  </div>
</RootLayout>
