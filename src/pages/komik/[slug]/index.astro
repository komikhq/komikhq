---
import RootLayout from "@/layouts/RootLayout.astro";
import { ComicHeaderCard } from "@/components/komik/ComicHeaderCard";
import { ComicChapterList } from "@/components/komik/ComicChapterList";
import { ComicCommentSection } from "@/components/komik/ComicCommentSection";

const { slug } = Astro.params;
---

<RootLayout title={`Detail Komik ${slug} - KomikHQ`}>
  <div class="flex flex-col gap-6 pb-20 pt-4 px-4 max-w-screen-2xl mx-auto">
    <ComicHeaderCard slug={slug} client:load />
    <ComicChapterList slug={slug} client:load />
    <ComicCommentSection slug={slug} client:load />
  </div>
</RootLayout>
