---
import RootLayout from "@/layouts/root-layout.astro"
import { HomeHeroCard } from "@/components/home/home-hero-card"
import { HomeTrendingSection } from "@/components/home/home-trending-section"
import { HomePopularSection } from "@/components/home/home-popular-section"
import { HomeLatestAddedSection } from "@/components/home/home-latest-added-section"
import { HomeGenreComicsSection } from "@/components/home/home-genre-comics-section"
import { HomeTopGenresCard } from "@/components/home/home-top-genres-card"
import { HomeAllGenresCard } from "@/components/home/home-all-genres-card"
---

<RootLayout title="KomikHQ - Read Manga, Manhwa, and Manhua Online">
  <div class="mx-auto flex max-w-screen-2xl flex-col gap-6 px-4 pt-4 pb-20">
    <HomeHeroCard client:load />
    <HomeTrendingSection client:load />
    <HomePopularSection client:load />
    <HomeLatestAddedSection client:load />
    <HomeGenreComicsSection client:load />
    <HomeTopGenresCard client:load />
    <HomeAllGenresCard client:load />
  </div>
</RootLayout>
