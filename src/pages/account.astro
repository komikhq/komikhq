---
import RootLayout from "@/layouts/RootLayout.astro";
import { AccountTabNav } from "@/components/account/AccountTabNav";
import { AccountProfileView } from "@/components/account/AccountProfileView";
import { UserCircle } from "@phosphor-icons/react";
---

<RootLayout title="Profil Saya - KomikHQ">
  <div class="max-w-4xl mx-auto flex flex-col gap-6 pb-20 pt-4 px-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight flex items-center gap-2">
          <UserCircle className="h-6 w-6 text-primary" />
          <span>Account Center</span>
        </h1>
        <p class="text-sm text-muted-foreground">
          Kelola profil pribadi, kredensial, dan preferensi aplikasi Anda.
        </p>
      </div>

      <AccountTabNav currentTab="profile" client:load />
    </div>

    <AccountProfileView client:only="react" />
  </div>
</RootLayout>

