---
import RootLayout from "@/layouts/RootLayout.astro"
import { AccountTabNav } from "@/components/account/AccountTabNav"
import { AccountProfileView } from "@/components/account/AccountProfileView"
import { UserCircle } from "@phosphor-icons/react"
---

<RootLayout title="My Profile | KomikHQ" noIndex={true}>
  <div class="mx-auto flex max-w-4xl flex-col gap-6 px-4 pt-4 pb-20">
    <div
      class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center"
    >
      <div>
        <h1 class="flex items-center gap-2 text-2xl font-bold tracking-tight">
          <UserCircle className="h-6 w-6 text-primary" />
          <span>Account Center</span>
        </h1>
        <p class="text-sm text-muted-foreground">
          Manage your personal profile, credentials, and app preferences.
        </p>
      </div>

      <AccountTabNav currentTab="profile" client:load />
    </div>

    <AccountProfileView client:only="react" />
  </div>
</RootLayout>
