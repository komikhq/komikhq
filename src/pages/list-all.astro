---
import RootLayout from "@/layouts/RootLayout.astro"
import { ListAllFilterBar } from "@/components/list-all/ListAllFilterBar"
import { ListAllComicTable } from "@/components/list-all/ListAllComicTable"
---

<RootLayout
  title="All Comics A-Z in Bahasa Indonesia | KomikHQ"
  description="Browse the complete alphabetical A to Z catalog of comics, manga, manhwa, and manhua in Bahasa Indonesia on KomikHQ."
>
  <div class="mx-auto flex max-w-screen-2xl flex-col gap-6 px-4 pt-4 pb-20">
    <ListAllFilterBar client:load />
    <ListAllComicTable client:load />
  </div>
</RootLayout>
