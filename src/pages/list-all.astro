---
import RootLayout from "@/layouts/root-layout.astro"
import { ListAllFilterBar } from "@/components/list-all/list-all-filter-bar"
import { ListAllComicTable } from "@/components/list-all/list-all-comic-table"
---

<RootLayout
  title="All Comics A-Z | KomikHQ"
  description="Browse the complete alphabetical A to Z catalog of comics, manga, manhwa, and manhua on KomikHQ."
>
  <div class="mx-auto flex max-w-screen-2xl flex-col gap-6 px-4 pt-4 pb-20">
    <ListAllFilterBar client:load />
    <ListAllComicTable client:load />
  </div>
</RootLayout>
