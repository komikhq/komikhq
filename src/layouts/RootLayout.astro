---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SiteHeader } from "@/components/common/SiteHeader";
import { BottomNav } from "@/components/common/BottomNav";
import { Toaster } from "@/components/ui/sonner";
import { GlobalPresenceListener } from "@/components/common/GlobalPresenceListener";
import { SITE_NAME, SITE_DESCRIPTION } from "@/constants";

interface Props {
  title?: string;
  description?: string;
  isReaderMode?: boolean;
}

const { title = SITE_NAME, description = SITE_DESCRIPTION, isReaderMode = false } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />

    <script is:inline>
      (function () {
        function getTheme() {
          try {
            var stored = localStorage.getItem("theme");
            var supportDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            if (stored === "dark" || (!stored && supportDark) || (stored === "system" && supportDark)) {
              return "dark";
            }
            return "light";
          } catch (e) {
            return "dark";
          }
        }

        function applyTheme(doc) {
          var targetDoc = doc || document;
          var theme = getTheme();
          if (theme === "dark") {
            targetDoc.documentElement.classList.add("dark");
          } else {
            targetDoc.documentElement.classList.remove("dark");
          }
        }

        applyTheme();

        document.addEventListener("astro:before-swap", function (ev) {
          applyTheme(ev.newDocument);
        });

        document.addEventListener("astro:after-swap", function () {
          applyTheme();
        });
      })();
    </script>

    <script is:inline define:vars={{ apiUrl: import.meta.env.PUBLIC_API_URL || "http://localhost:8787" }}>
      window.__PUBLIC_API_URL__ = apiUrl;
    </script>
  </head>
  <body class={isReaderMode ? "min-h-screen bg-neutral-950 text-neutral-100 antialiased selection:bg-primary selection:text-primary-foreground" : "min-h-screen bg-background text-foreground antialiased selection:bg-primary selection:text-primary-foreground"}>
    <GlobalPresenceListener client:only="react" />
    <div class="relative flex min-h-screen flex-col">
      {!isReaderMode && <SiteHeader client:load />}
      <main class={isReaderMode ? "flex-1" : "flex-1 pb-16 md:pb-0"}>
        <slot />
      </main>
      {!isReaderMode && <BottomNav client:load />}
      <Toaster client:load position="top-right" richColors />
    </div>
  </body>
</html>
