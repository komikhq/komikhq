{
  "name": "komikhq-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.3.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "astro build && wrangler deploy",
    "deploy:cf": "wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path .gitignore \"**/*.{ts,tsx,astro,md,json}\" \"*.{js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check --ignore-path .gitignore \"**/*.{ts,tsx,astro,md,json}\" \"*.{js,mjs,cjs,json,md}\"",
    "typecheck": "astro check",
    "generate:logo": "tsx scripts/create-logo/index.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^5",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "^7.3.1",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "next-themes": "^0.4.6",
    "pusher-js": "^8.6.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^6.2.3",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@eslint/js": "^10",
    "@types/node": "^26.4.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "wrangler": "^4.129.0"
  }
}
